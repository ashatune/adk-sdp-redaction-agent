# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=000000000000

# Regional & Multi-Regional Endpoints
SDP_LOCATION=us
AGENT_ENGINE_REGION=us-west1
VERTEX_LOCATION=global

# Vertex AI Model Configuration
GEMINI_MODEL=gemini-2.5-flash
FALLBACK_GEMINI_MODEL=gemini-2.5-pro

# Cloud Sensitive Data Protection (SDP / DLP) Templates
SDP_INSPECT_TEMPLATE_PATH=projects/your-gcp-project-id/locations/us/inspectTemplates/legal-sdp-inspect
SDP_DEIDENTIFY_TEMPLATE_PATH=projects/your-gcp-project-id/locations/us/deidentifyTemplates/legal-deid-template

# Cloud Model Armor Templates
MODEL_ARMOR_PROMPT_TEMPLATE_ID=legal-prompt-template
MODEL_ARMOR_RESPONSE_TEMPLATE_ID=legal-response-template
ENABLE_MODEL_ARMOR_API=true

# Gemini Enterprise & Discovery Engine Data Store
GEMINI_ENTERPRISE_ENGINE_ID=your-gemini-enterprise-engine-id
DISCOVERY_ENGINE_DATA_STORE_ID=projects/000000000000/locations/global/collections/default_collection/dataStores/your-data-store-id
ENABLE_DATASTORE_SEARCH=true
